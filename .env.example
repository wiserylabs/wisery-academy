# Copy this to .env and adjust. The same variables work on a laptop, a VPS,
# or AWS — only their values change between environments.

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# --- Database (swap for an RDS endpoint in AWS, same variable) ---
POSTGRES_DB=wisery_academy
POSTGRES_USER=wisery
POSTGRES_PASSWORD=wisery
DATABASE_URL=postgres://wisery:wisery@db:5432/wisery_academy

# --- File storage: MinIO here, Amazon S3 in AWS (same S3 API) ---
# In AWS: delete/blank out S3_ENDPOINT_URL so boto3 talks to real S3,
# and point S3_ACCESS_KEY / S3_SECRET_KEY at an IAM user or role instead.
S3_ENDPOINT_URL=http://storage:9000
S3_ACCESS_KEY=wisery-admin
S3_SECRET_KEY=wisery-admin-secret
S3_BUCKET=wisery-academy-files
S3_REGION=us-east-1

# --- Frontend ---
VITE_API_URL=/api

# --- Optional: bootstrap admin auto-created on api container start ---
# When set, an Editor account is ensured on every boot (idempotent) so a fresh
# deploy always has a login. Leave unset in local dev if you use seed_demo or
# createsuperuser instead.
# ADMIN_EMAIL=admin@wiserylabs.ai
# ADMIN_PASSWORD=change-me-at-least-8-chars
# ADMIN_NAME=Portal Admin
# ADMIN_FORCE_PASSWORD=0   # set to 1 to reset the password to ADMIN_PASSWORD on next boot
