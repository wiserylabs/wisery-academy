# Production environment for the single-EC2 (all-in-Docker) deployment.
# Copy this to `.env` ON THE SERVER and fill in the real values. Never commit
# the filled-in file -- .env is gitignored.
#
# Generate strong secrets, e.g.:
#   DJANGO_SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(50))"
#   passwords/keys:     openssl rand -base64 24

# --- Django ---
DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_50_char_random_string

# The host(s) the site is served on. Use your domain, or the EC2 public DNS
# name if you have no domain yet. Comma-separated, no scheme.
ALLOWED_HOSTS=portal.example.com

# The browser origin(s), WITH scheme. Match ALLOWED_HOSTS.
CORS_ALLOWED_ORIGINS=https://portal.example.com
# Needed for the Django admin login to work behind HTTPS termination.
CSRF_TRUSTED_ORIGINS=https://portal.example.com

# --- Caddy / TLS ---
# A bare domain => automatic Let's Encrypt HTTPS on 443.
# ":80"        => plain HTTP (e.g. http://<ec2-public-dns> for a quick demo).
SITE_ADDRESS=portal.example.com

# --- Bootstrap admin (the "never locked out" safety net) ---
# The api container ensures this Editor account exists on every deploy, so a
# fresh box always has a working login. Set a strong password.
ADMIN_EMAIL=admin@wiserylabs.ai
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_NAME=Portal Admin
# Existing accounts keep their password across deploys. Set this to 1 for one
# deploy to force-reset ADMIN_EMAIL's password back to ADMIN_PASSWORD (e.g. to
# recover access), then set it back to 0.
ADMIN_FORCE_PASSWORD=0

# --- Database (Postgres container on this box) ---
POSTGRES_DB=wisery_academy
POSTGRES_USER=wisery
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgres://wisery:CHANGE_ME_strong_db_password@db:5432/wisery_academy

# --- File storage (MinIO container on this box) ---
# Internal endpoint only -- never exposed to the internet.
S3_ENDPOINT_URL=http://storage:9000
S3_ACCESS_KEY=CHANGE_ME_minio_access_key
S3_SECRET_KEY=CHANGE_ME_minio_secret_key
S3_BUCKET=wisery-academy-files
S3_REGION=us-east-1

# --- Frontend ---
# Same-origin API path via Caddy; leave as /api.
VITE_API_URL=/api
